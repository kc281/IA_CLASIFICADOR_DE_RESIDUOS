# ─── Modelo ──────────────────────────────────────
MODEL_PATH=models/mobilenetv2_waste.h5
MODEL_NAME=MobileNetV2
INPUT_SIZE=224

# ─── Validación de archivos ──────────────────────
MAX_FILE_SIZE_MB=5

# ─── Umbral de confianza ─────────────────────────
LOW_CONFIDENCE_THRESHOLD=0.60

# ─── CORS (orígenes del frontend) ────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173